/* فقط این الگو داخل Core/Src/main.c بعد از MX_*_Init() قرار بگیرد. */
/* منطق محصول اینجا نوشته نشود. */

#include "app.h"

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();
    MX_USART1_UART_Init();

    App_Start();   /* هرگز برنمی‌گردد: Init + Task + scheduler */

    while (1)
    {
        /* نباید به اینجا برسد */
    }
}
