/* الگوی main.c برای مرحله LED و بازر.
 * ADC / TIM / USART را در این مرحله صدا نزن؛ در CubeMX هم لازم نیست Enable باشند.
 *
 * فقط داخل بلوک‌های USER CODE چیزی بنویس تا Generate بعدی پاکشان نکند.
 */

#include "app.h"

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* osKernelInitialize / MX_FREERTOS_Init / osKernelStart را صدا نزن. */
    App_Start();

    while (1)
    {
        /* App_Start برنمی‌گردد. */
    }
}
