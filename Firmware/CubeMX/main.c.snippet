 * @file    main.c.snippet
 * @brief   [EN] Pattern for CubeMX main.c at the LED/buzzer stage.
 *          [FA] الگوی main.c مکعب در مرحله LED و بازر.
 *
 * @note    [EN] Write only inside USER CODE blocks so Generate does not erase it.
 *          [FA] فقط داخل USER CODE بنویس تا Generate پاک نکند.
 *          [EN] Do not call ADC / TIM / USART in this stage.
 *          [FA] ADC / TIM / USART را در این مرحله صدا نزن.
 */

#include "app.h"

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* osKernelInitialize / MX_FREERTOS_Init / osKernelStart را صدا نزن. */
    App_Start();

    while (1)
    {
        /* App_Start برنمی‌گردد. */
    }
}
